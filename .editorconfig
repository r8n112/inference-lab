# https://editorconfig.org
# Markdown is deliberately excluded from trailing-whitespace trimming: a double
# trailing space is a hard line break and leading whitespace can carry list
# nesting. Same policy as our hetzneronline/community-content contribution.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.svelte]
indent_size = 2

[*.sh]
indent_size = 4

[{Makefile,makefile}]
indent_style = tab
