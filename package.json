{
	"name": "inference-lab",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "A static, offline-capable PWA of small, well-implemented tools for open-weight models served by the Hetzner Experiments Inference API. Unofficial homage; not affiliated with Hetzner.",
	"license": "MIT OR Apache-2.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@vite-pwa/assets-generator": "^1.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
